{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "safe": {"()": "cryptoservice.observability.RequestFormatter"}
  },
  "handlers": {
    "stderr": {
      "class": "logging.StreamHandler",
      "formatter": "safe",
      "stream": "ext://sys.stderr"
    }
  },
  "root": {"handlers": ["stderr"], "level": "INFO"},
  "loggers": {
    "uvicorn": {"handlers": ["stderr"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": ["stderr"], "level": "INFO", "propagate": false},
    "uvicorn.access": {"handlers": [], "propagate": false},
    "cryptoService": {"handlers": ["stderr"], "level": "INFO", "propagate": false}
  }
}
